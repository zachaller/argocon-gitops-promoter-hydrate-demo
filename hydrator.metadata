  "body": "Signed-off-by: Zach Aller <zach_aller@intuit.com>\n",
  "references": [
    {
      "commit": {
        "author": "\"Zach Aller\" <code@example.com>",
        "date": "2026-10-12T17:22:07-06:00",
        "subject": "test: wait for git, not ChangeTransferPolicy status, before the revert push (#2283)",
        "body": "The revert detection spec waits for staging to be idle before pushing a\nrevert commit to its active branch, so a promotion can't land on top of it.\nIt judged idle from ChangeTransferPolicy status, which can lag the\nrepository: a newer dry SHA can already be on staging's proposed branch\nwhile the status still shows the old one. Its promotion then merges on top\nof the revert, the gate evaluates that merge commit, and staging stays\nsuccess.\n\nAlso wait until staging's active branch carries the proposed branch's dry\nSHA in the repository itself.\n\n\nClaude-Session: https://claude.ai/code/session_01KMbKRJK45xAEBq9tQoc9DG\n\nSigned-off-by: Michael Crenshaw <350466+crenshaw-dev@users.noreply.github.com>\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>",
        "sha": "8e528e784fb91d7d416d971fcb510cee7ece1f3d",
        "repoUrl": "https://github.com/argoproj-labs/gitops-promoter"
      }
    }
  ]
}
