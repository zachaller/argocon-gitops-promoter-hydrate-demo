      "commit": {
        "author": "\"Zach Aller\" <code@example.com>",
        "date": "2026-10-19T06:15:29-05:00",
        "subject": "feat(ui): add promotion map and environment filtering (#2217)",
        "body": "Add a collapsible, pannable and zoomable promotion map above the commit\ngrid, drawn from the promotionGraph DAG. Clicking an environment node\nfilters the grid to that environment, shift-click adds or removes\nnodes, and Escape or a click on the empty canvas clears the selection.\nThe Environment dropdown and the map stay in sync, and the selected\ncell lights its commit path through the map.\n\nAdd initialSelectedEnvs and onSelectedEnvsChange props and the\nparseEnvSelection and formatEnvSelection helpers so hosts can persist\nthe selection. The hosts do not use them yet.\n\nSigned-off-by: Jonathan Winters <wintersjonathan0@gmail.com>",
        "sha": "dd01287142ddd00d8e0d42a4a1f343adb68515e9",
        "repoUrl": "https://github.com/argoproj-labs/gitops-promoter"
      }
    }
  ]
}
