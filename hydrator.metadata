      "commit": {
        "author": "\"svc-ci\" <code@example.com>",
        "date": "2026-09-17T15:28:03-05:00",
        "subject": "refactor(git): slim GetBranchSha to branch-tip resolution only (#1952)",
        "body": "* refactor(git): split dry metadata read out of GetBranchShas\n\nGetBranchShas now resolves only the hydrated branch tip; callers read\nhydrator.metadata separately via GetShaMetadataFromFile after prefetching\nthe tip commit, enabling batched git reads in the reconcile path.\n\nSigned-off-by: Zach Aller <zachaller@users.noreply.github.com>\n\n* refactor(git): rename GetBranchShas to GetBranchSha\n\nDrop the BranchShas wrapper and return the origin/<branch> commit SHA\ndirectly now that dry metadata is read separately.\n\nSigned-off-by: Zach Aller <zachaller@users.noreply.github.com>\n\n---------\n\nSigned-off-by: Zach Aller <zachaller@users.noreply.github.com>",
        "sha": "456a1b4b9dbd9852564d7eed2ce74b8c3d6e8f0d",
        "repoUrl": "https://github.com/argoproj-labs/gitops-promoter"
      }
    }
